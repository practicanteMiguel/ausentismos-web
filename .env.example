# ---- URL pública de la app (usada para construir enlaces de invitación) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Firebase (cliente) — Project settings > General > Your apps > Web app ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (servidor) — Project settings > Service accounts > Generate new private key ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la private_key del JSON tal cual, con \n literales (no reemplazar por saltos de línea reales)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Google Drive (Service Account con Drive API habilitada) ----
# Puede ser el MISMO service account de Firebase Admin (agregar rol/API de Drive) u otro dedicado.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID de la Unidad compartida (Shared Drive) "Ausentismos", con el Service Account agregado como
# miembro (Content Manager o superior). Las Service Accounts no tienen cuota propia en "Mi unidad",
# por eso el almacenamiento DEBE ser una Unidad compartida (requiere Google Workspace). Ver SETUP.md.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
